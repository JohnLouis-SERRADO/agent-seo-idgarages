# =============================================================================
# Agent SEO idgarages.com - Configuration
# Copie ce fichier en .env puis remplis tes vraies valeurs.
# Ne JAMAIS commiter .env (il est dans .gitignore).
# =============================================================================

# --- API Anthropic (Claude) ---
# Obtient ta cl\xc3\xa9 sur https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Site \xc3\xa0 monitorer ---
TARGET_SITE=https://www.idgarages.com
MAX_PAGES_PER_DAY=500
CRAWL_DELAY_SECONDS=1.0
REQUEST_TIMEOUT=15
# Respect du robots.txt. \xc3\x80 laisser "true" sauf si tu monitores TON
# PROPRE site dont le robots.txt interdit les crawlers non-r\xc3\xa9f\xc3\xa9renc\xc3\xa9s.
RESPECT_ROBOTS_TXT=true

# --- Email (Gmail SMTP) ---
# 1. Active la validation en 2 \xc3\xa9tapes sur ton compte Google
# 2. G\xc3\xa9n\xc3\xa8re un "mot de passe d'application" :
#    https://myaccount.google.com/apppasswords
# 3. Colle ce mot de passe de 16 caract\xc3\xa8res ci-dessous (SANS espaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton.email@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
EMAIL_FROM=ton.email@gmail.com
EMAIL_TO=destinataire@example.com

# --- Planning ---
# Heure du crawl quotidien (format 24h)
DAILY_CRAWL_TIME=03:00
# Heure et jour d'envoi du rapport hebdomadaire
WEEKLY_REPORT_DAY=friday
WEEKLY_REPORT_TIME=11:00

# --- Logs ---
LOG_LEVEL=INFO
