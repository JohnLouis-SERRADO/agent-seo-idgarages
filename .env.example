# =============================================================================
# Agent SEO idgarages.com - Configuration
# Copie ce fichier en .env puis remplis tes vraies valeurs.
# Ne JAMAIS commiter .env (il est dans .gitignore).
# =============================================================================

# --- API Anthropic (Claude) ---
# Obtiens ta clé sur https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Plafond de tokens par rapport. Le thinking adaptatif partage ce budget avec
# le HTML produit : en dessous de ~16000, le rapport risque d'être tronqué.
CLAUDE_MAX_TOKENS=32000

# --- Site à monitorer ---
TARGET_SITE=https://www.idgarages.com
MAX_PAGES_PER_DAY=500
CRAWL_DELAY_SECONDS=1.0
REQUEST_TIMEOUT=15
# Durée maximale d'un cycle de crawl. Au-delà, l'agent s'arrête proprement,
# sauvegarde ce qu'il a trouvé, et reprend au cycle suivant là où il en était.
# À garder sous le timeout-minutes du workflow GitHub Actions (30 min).
MAX_CRAWL_MINUTES=20
# Nombre de redirections à partir duquel une chaîne est signalée.
MAX_REDIRECT_HOPS=3

# Respect du robots.txt.
# - true  : on saute les URLs interdites par une règle réellement lue.
#           Un robots.txt illisible (bloqué par le CDN) n'interdit RIEN :
#           l'agent log un warning et continue.
# - false : on ignore robots.txt. Légitime pour monitorer TON PROPRE site,
#           dont le robots.txt interdit les crawlers non référencés.
RESPECT_ROBOTS_TXT=true

# --- Email (Gmail SMTP) ---
# 1. Active la validation en 2 étapes sur ton compte Google
# 2. Génère un "mot de passe d'application" :
#    https://myaccount.google.com/apppasswords
# 3. Colle ce mot de passe de 16 caractères ci-dessous (SANS espaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton.email@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
EMAIL_FROM=ton.email@gmail.com
EMAIL_TO=destinataire@example.com

# --- Planning (mode démon local uniquement) ---
# Heure du crawl quotidien (format 24h)
DAILY_CRAWL_TIME=03:00
# Heure et jour d'envoi du rapport hebdomadaire
WEEKLY_REPORT_DAY=friday
WEEKLY_REPORT_TIME=11:00

# --- Logs ---
LOG_LEVEL=INFO
